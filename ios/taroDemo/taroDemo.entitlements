<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Universal Link（NA-L03）：微信授权完成后经 https://<域名>/app/... 回跳本 App。
	  域名必须与 .env 的 TARO_APP_WX_UNIVERSAL_LINK、微信开放平台登记的 Universal Links 一致，
	  且该域名根下 /.well-known/apple-app-site-association 可访问（website/public/.well-known/）。
	  换正式域名时三处同步；scripts/rn/ios-native-check.mjs 会校验这里与 .env 一致。
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:TODO-your-universal-link-host.example.com</string>
	</array>
	<!-- 通过 Apple 登录（NA-L04，App Store 审核指南 4.8） -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
