{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.0",
  "envId": "{{env.TARO_APP_CLOUD_ENV_ID}}",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "user",
      "description": "login / consent / confirmAdult / updateSettings / whoami / wechatAppLogin / bindWechat / appleLogin / bindApple / linkPhoneSession / bindPhoneWeapp / deleteAccount",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true,
      "ignore": [
        "node_modules",
        "node_modules/**/*"
      ],
      "envVariables": {
        "WX_APP_ID": "{{env.WX_APP_ID}}",
        "WX_APP_SECRET": "{{env.WX_APP_SECRET}}",
        "TCB_CUSTOM_LOGIN_JSON": "{{env.CLOUDBASE_CUSTOM_LOGIN_JSON}}",
        "TCB_CUSTOM_LOGIN_KEY_ID": "{{env.CLOUDBASE_CUSTOM_LOGIN_KEY_ID}}",
        "APPLE_TEAM_ID": "{{env.APPLE_TEAM_ID}}",
        "APPLE_KEY_ID": "{{env.APPLE_KEY_ID}}",
        "APPLE_PRIVATE_KEY": "{{env.APPLE_PRIVATE_KEY}}",
        "WX_MP_APP_ID": "{{env.WX_MP_APP_ID}}",
        "WX_MP_APP_SECRET": "{{env.WX_MP_APP_SECRET}}",
        "PHONE_HASH_SECRET": "{{env.PHONE_HASH_SECRET}}"
      }
    },
    {
      "name": "community",
      "description": "ping / getProfile / updateProfile（M1）/ circles / invites / topics / replies（M3、M4）",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true,
      "ignore": [
        "node_modules",
        "node_modules/**/*"
      ],
      "envVariables": {
        "WX_MP_APP_ID": "{{env.WX_MP_APP_ID}}",
        "WX_MP_APP_SECRET": "{{env.WX_MP_APP_SECRET}}"
      }
    },
    {
      "name": "moderation",
      "description": "ping / report / queue / decide（M2）；图片机审回调（BE-M2-02）",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true,
      "ignore": [
        "node_modules",
        "node_modules/**/*"
      ],
      "envVariables": {
        "WX_MP_APP_ID": "{{env.WX_MP_APP_ID}}",
        "WX_MP_APP_SECRET": "{{env.WX_MP_APP_SECRET}}"
      }
    },
    {
      "name": "practice",
      "description": "ping / checkin / dailyPrompt / notifications（M5、M6）；每日提醒由定时触发器唤起",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true,
      "ignore": [
        "node_modules",
        "node_modules/**/*"
      ],
      "triggers": [
        {
          "name": "dailyPromptReminder",
          "type": "timer",
          "config": "0 0 8 * * * *"
        }
      ]
    },
    {
      "name": "mediacheck",
      "description": "图片异步机审回调（微信消息推送），通过则生效、违规则删除，客户端无权调用（BE-M2-02）",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true,
      "ignore": [
        "node_modules",
        "node_modules/**/*"
      ],
      "envVariables": {
        "WX_MP_APP_ID": "{{env.WX_MP_APP_ID}}"
      }
    }
  ]
}
