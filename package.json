    "@tarojs/plugin-inject": "3.6.40",
    "@tarojs/rn-runner": "3.6.40",
    "@tarojs/taro-loader": "3.6.40",
    "@tarojs/webpack5-runner": "3.6.40",
    "@types/jest": "29",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.69.8",
    "@types/react-test-renderer": "18",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^5.20.0",
    "@typescript-eslint/parser": "^5.20.0",
    "autoprefixer": "^10.6.1",
    "babel-jest": "29",
    "babel-preset-taro": "3.6.40",
    "eslint": "^8.12.0",
    "eslint-config-taro": "3.6.40",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-react": "^7.8.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "install-peerdeps": "^3.0.3",
    "jest": "29",
    "lucide-static": "^1.48.0",
    "pinyin-pro": "^3.29.4",
    "pod-install": "^0.1.23",
    "postcss": "^8.4.18",
    "postcss-rem-to-responsive-pixel": "^7.0.6",
    "react-refresh": "^0.11.0",
    "react-test-renderer": "18.2.0",
    "stylelint": "9.3.0",
    "tailwindcss": "^3",
    "ts-node": "^10.9.1",
    "typescript": "^4.1.0",
    "weapp-tailwindcss": "^4.12.0",
    "webpack": "5.91.0"
  },
  "resolutions": {
    "webpack": "5.91.0",
    "enhanced-resolve": "5.17.1"
  }
