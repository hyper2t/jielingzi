{
  "name": "jielingzi",
  "version": "1.0.0",
  "private": true,
  "description": "结灵子",
  "templateInfo": {
    "name": "react-native",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:rn:android": "node scripts/rn/bundle.mjs --platform android",
    "build:rn:ios": "node scripts/rn/bundle.mjs --platform ios",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:quickapp": "taro build --type quickapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch --qr",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:quickapp": "npm run build:quickapp -- --watch",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "podInstall": "pod-install",
    "upgradePeerdeps": "install-peerdeps @tarojs/taro-rn@3.6.40 -o -Y && install-peerdeps @tarojs/components-rn@3.6.40 -o -Y && install-peerdeps @tarojs/router-rn@3.6.40 -o -Y && pod-install",
    "test:ops": "node --test scripts/ops/*.test.ts scripts/ops/*.test.mjs",
    "ops:usage": "node scripts/ops/usage.ts",
    "ops:backup": "node scripts/ops/backup.ts",
    "ops:security-rules": "node scripts/ops/security-rules.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "gen:icons": "node tools/gen-icons.js",
    "test:functions": "node scripts/sync-shared.mjs && node --test tests/cloudfunctions/*.test.js",
    "rn:smoke": "node scripts/rn/http-api-smoke.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-location",
        "expo-sensors",
        "expo-brightness",
        "expo-barcode-scanner",
        "expo-image-picker"
      ]
    }
  },
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.7.7",
    "@cloudbase/js-sdk": "^2",
    "@cloudbase/node-sdk": "^3.18.3",
    "@invertase/react-native-apple-authentication": "2.5.1",
    "@react-native-async-storage/async-storage": "~1.17.7",
    "@react-native-community/netinfo": "~9.3.0",
    "@tarojs/components": "3.6.40",
    "@tarojs/helper": "3.6.40",
    "@tarojs/plugin-framework-react": "3.6.40",
    "@tarojs/plugin-platform-alipay": "3.6.40",
    "@tarojs/plugin-platform-h5": "3.6.40",
    "@tarojs/plugin-platform-jd": "3.6.40",
    "@tarojs/plugin-platform-qq": "3.6.40",
    "@tarojs/plugin-platform-swan": "3.6.40",
    "@tarojs/plugin-platform-tt": "3.6.40",
    "@tarojs/plugin-platform-weapp": "3.6.40",
    "@tarojs/react": "3.6.40",
    "@tarojs/rn-supporter": "3.6.40",
    "@tarojs/runtime": "3.6.40",
    "@tarojs/runtime-rn": "3.6.40",
    "@tarojs/shared": "3.6.40",
    "@tarojs/taro": "3.6.40",
    "@tarojs/taro-rn": "3.6.40",
    "expo": "~47.0.14",
    "expo-av": "~13.0.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-native": "^0.70.1",
    "react-native-device-info": "~10.3.0",
    "react-native-gesture-handler": "~2.9.0",
    "react-native-root-siblings": "^4.1.1",
    "react-native-safe-area-context": "~4.4.1",
    "react-native-screens": "~3.20.0",
    "react-native-track-player": "^4.1.2",
    "react-native-wechat-lib": "3.0.4",
    "stylelint-taro-rn": "3.6.40",
    "twrnc": "^4.16.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
