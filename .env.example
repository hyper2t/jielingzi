# 复制为 .env 后填写；.env 已在 .gitignore 中忽略，禁止提交真实密钥
#
# ===== 前端变量（会被 Taro 注入业务代码，只能放可公开的值）=====
# Taro 只会注入 TARO_APP_ 前缀的变量到业务代码（小程序 / H5 / App 三端一样）。
# 变量名含 API_KEY / SECRET / PRIVATE / PASSWORD / TOKEN 的一律不能加这个前缀，config/client-env.js 会在构建时断言并中止。
# CloudBase 环境 ID（单一环境，开发/生产共用）
TARO_APP_CLOUD_ENV_ID=
# 地域（H5 js-sdk 用，可选）
TARO_APP_CLOUD_REGION=
# 客户端 Publishable Key（可公开）：H5 js-sdk 匿名登录用；App 端用它调 HTTP API 的免身份动作 / 公开函数、发起手机号 / 微信 / Apple 登录
TARO_APP_CLOUD_ACCESS_KEY=
# 数据源：mock（本地假数据，仅开发用）| cloud（真实云函数/数据库，上线包必须为 cloud）
# 上线前检查见 docs/ops/release-checklist.md
TARO_APP_DATA_SOURCE=cloud
# 字体子集所在 CDN 目录（可选，不配则使用系统衬线字体）
TARO_APP_FONT_BASE_URL=
# App 微信登录：微信开放平台「移动应用」AppID（可公开）与 iOS Universal Link；为空时 App 内不显示「微信登录」。
# CI 用 Repository Variables（不是 Secrets）注入同名变量。AppSecret 绝不能带 TARO_APP_ 前缀，见下方 WX_APP_SECRET
TARO_APP_WX_APP_ID=
TARO_APP_WX_UNIVERSAL_LINK=

# ===== 本地脚本变量（运维脚本，禁止加 TARO_APP_ 前缀，不会进入前端包）=====
# 腾讯云 API 密钥（scripts/ops 下的备份 / 安全规则 / 建集合脚本用；建议子账号，最小权限）
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=
# CloudBase 管理员 API Key（控制台「API Key 管理」，仅 scripts/rn/http-api-smoke.mjs --admin 等本地脚本用；
# 曾以 TARO_APP_CLOUD_API_KEY 存在过，已改名并要求在控制台重新生成一次。严禁进入客户端）
CLOUDBASE_API_KEY=

# ===== 登录体系（docs/api/user.md）：经 cloudbaserc.json 的 envVariables 注入云函数 user，禁止加 TARO_APP_ 前缀 =====
# 微信开放平台「移动应用」的 AppID / AppSecret（App 微信登录用；小程序的 AppID 不是这个）。没配时 wechatAppLogin 返回 50201
WX_APP_ID=
WX_APP_SECRET=
# CloudBase 自定义登录私钥：控制台 → 身份认证 → 登录方式 → 自定义登录 → 下载私钥（JSON 文件）→ 整个文件 base64 后填入
# （也接受 JSON 原文，或只含 PEM 私钥；只放 PEM 时必须再填下面的私钥 ID）
CLOUDBASE_CUSTOM_LOGIN_JSON=
# 只在 CLOUDBASE_CUSTOM_LOGIN_JSON 不含 private_key_id 时需要：控制台自定义登录页显示的「私钥 ID」
CLOUDBASE_CUSTOM_LOGIN_KEY_ID=
# 通过 Apple 登录：注销账号时撤销 Apple 授权用（Apple Developer → Keys →「Sign in with Apple」密钥）。不配只影响撤销，登录不受影响
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ===== 实名与内容安全（docs/api/user.md bindPhoneWeapp）：经 cloudbaserc.json 注入云函数 user / moderation，禁止加 TARO_APP_ 前缀 =====
# 微信小程序 AppID / AppSecret（小程序后台 → 开发管理 → 开发设置）。与上面的 WX_APP_ID（开放平台「移动应用」）不是同一套。
# user.bindPhoneWeapp（手机号快速验证）与 moderation（M2：msgSecCheck / mediaCheckAsync）用；没配时 bindPhoneWeapp 返回 50201
WX_MP_APP_ID=
WX_MP_APP_SECRET=
# 手机号哈希密钥（≥ 16 位随机串，如 openssl rand -hex 32）：users.phoneHash 与 phone: 别名用 HMAC-SHA256 计算，不存手机号明文。
# 一旦启用**不可更换**（否则已绑定的手机号全部失效）。没配时 bindPhoneWeapp 返回 50201；App 手机号登录照常视为实名，但不做小程序 / App 同号识别
PHONE_HASH_SECRET=
